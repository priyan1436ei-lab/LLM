# FITTRACK AI — environment configuration
#
# Copy to `.env.local` and fill in what you have. Every value is OPTIONAL in development:
# the app runs and reports honestly on what is missing. In production, missing required
# values fail the boot (see `productionReadinessProblems` in src/lib/env.ts).
#
# SECURITY: none of these are NEXT_PUBLIC_*, so no value can be inlined into a browser
# bundle. Never prefix a secret with NEXT_PUBLIC_.

# ---- Application -------------------------------------------------------------
NODE_ENV=development
# development | preview | production
APP_ENV=development
APP_URL=http://localhost:3000

# ---- Database ----------------------------------------------------------------
# auto     : use DATABASE_URL when set, else the embedded real-Postgres engine
# pglite   : force the embedded engine (genuine PostgreSQL 18.3 compiled to WASM)
# postgres : force DATABASE_URL and refuse to start without it
#
# NOTE: the embedded engine is single-writer. Exactly one process may open a data
# directory at a time; two processes would silently lose writes.
DB_SUBSTRATE=pglite
PGLITE_DATA_DIR=.data/pglite

# Required only when DB_SUBSTRATE=postgres, e.g.
# postgresql://user:credential@host:5432/fittrack
# DATABASE_URL=

# ---- Sessions ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production. Also keys IP hashing in audit logs.
# SESSION_SECRET=

# ---- Storage -----------------------------------------------------------------
STORAGE_DIR=.data/storage
MAX_UPLOAD_BYTES=8388608

# ---- AI providers ------------------------------------------------------------
# Leave the provider as `none` with no key to run without AI. Features then report
# "Not configured" rather than returning fabricated results. This is the default.
AI_VISION_PROVIDER=none
AI_VISION_MODEL=gpt-4o-mini
AI_LLM_PROVIDER=none
AI_LLM_MODEL=gpt-4o-mini
AI_STT_PROVIDER=none
AI_STT_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=45000

# Set to enable photo analysis, the coach, text parsing and voice logging.
# OPENAI_API_KEY=

# ---- Nutrition data ----------------------------------------------------------
# local          : only products already in the database resolve by barcode
# openfoodfacts  : look packaged products up online
NUTRITION_PROVIDER=local
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org

# ---- Payments ----------------------------------------------------------------
# none    : checkout disabled and reported as such
# sandbox : local sandbox checkout, never valid in production
# stripe | razorpay : real provider, requires both keys below
PAYMENT_PROVIDER=none
PAYMENT_CURRENCY=INR
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# ---- Observability -----------------------------------------------------------
LOG_LEVEL=info
# SENTRY_DSN=

# ---- Analytics ---------------------------------------------------------------
ANALYTICS_ENABLED=true

# ---- Local seed only (never set these in production) -------------------------
# Used solely by `npm run db:seed -- --with-demo`. No credential is stored in code;
# without this the demo account is simply not created.
# DEMO_EMAIL=demo@fittrack.local
# DEMO_PASSWORD=
# DEMO_TIMEZONE=Asia/Kolkata
