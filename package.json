{
  "name": "fittrack-ai",
  "version": "0.1.0",
  "private": true,
  "description": "FITTRACK AI — production-grade real-time AI fitness & nutrition website",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:audit": "tsx scripts/audit-data.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-query": "^5.59.0",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^3.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
